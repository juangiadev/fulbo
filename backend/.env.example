PORT=3000
NODE_ENV=development
DEV_AUTH_BYPASS=false
FRONTEND_ORIGIN=http://localhost:5173

# Local postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fulboapp

# Auth0
AUTH0_ISSUER_URL=https://YOUR_DOMAIN/
AUTH0_AUDIENCE=https://fulboapp-api

# Optional, but recommended to enrich profile data from Auth0 Management API
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Optional API key auth for scripts; disabled when empty. Requests send the header
# x-fulbo-api-key plus x-fulbo-user-id (internal users.id UUID) and act as that user.
# The key can act as ANY user: treat it like an admin credential. Never commit real values.
FULBO_API_KEY=
